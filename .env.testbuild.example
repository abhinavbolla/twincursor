# A server to build into tc-engine for testers (crates/engine-cli/build.rs). Copy this file to
# .env.testbuild (ignored by git), fill it in, then:
#
#   set -a; . ./.env.testbuild; set +a; apps/desktop/scripts/bundle.sh
#
# Anyone who has the resulting build can read these values out of it, the secret included.
TWINCURSOR_BUILD_SERVER_URL=wss://your-project.example.com
TWINCURSOR_BUILD_API_KEY=your-api-key
TWINCURSOR_BUILD_API_SECRET=your-api-secret
